{
  "name": "iamkarsoft/kudi",
  "description": "A laravel package to convert currency to/from ghana cedis(GHS)",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/iamkarsoft/kudi",
  "authors": [
    {
      "name": "Kofi Ramos Amoussou",
      "email": "karsoft92@gmail.com",
      "role": "Web Developer"
    }
  ],
  "require": {
    "php": "^7.4|^8.0|^8.1|^8.2|^8.3|^8.4",
    "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Iamkarsoft\\Kudi\\": "src"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Iamkarsoft\\Kudi\\KudiServiceProvider"
      ],
      "aliases": {
        "Kudi": "Iamkarsoft\\Kudi\\Facades\\Kudi"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
